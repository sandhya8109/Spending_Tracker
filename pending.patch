-            if (this.isBackendConnected) {
-                const response = await fetch(`${this.apiBaseUrl}/process-receipt-base64`, {
-                    method: 'POST',
-                    headers: { 'Content-Type': 'application/json' },
-                    body: JSON.stringify({ image: imageDataUrl })
